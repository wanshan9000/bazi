# 元气 AI 前端：dsh（默认）| legacy（回退旧编排）
VITE_AGENT_BACKEND=dsh

# ---- 站点合规信息（不配则页脚相应条目不显示，绝不渲染占位符）----
# 备案号：上线到中国大陆主机时按实际备案填写
# VITE_ICP_NO=沪ICP备00000000号
# VITE_POLICE_NO=沪公网安备00000000000000号
# 隐私政策 / 用户协议的正式链接（法律文本需自行撰写后再挂出）
# VITE_LEGAL_PRIVACY_URL=
# VITE_LEGAL_TERMS_URL=
# 联系邮箱
# VITE_CONTACT_EMAIL=

# ---- 后端地址 ----
# 只写域名，不要带 /api（客户端自己会拼）。同域部署可不设。
# VITE_API_BASE=https://你的域名
# Cloudflare Turnstile Site key。生产后端还需配置 TURNSTILE_SECRET_KEY。
# VITE_TURNSTILE_SITE_KEY=

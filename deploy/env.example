# /etc/bazi/env —— bazi.service 的 EnvironmentFile。首次部署前在服务器上手工创建：
#   install -d -m 0750 /etc/bazi && install -m 0640 -o root -g bazi /dev/null /etc/bazi/env
# PORT / HOST / NODE_ENV / HOME 由 unit 提供，不要写在这里。

# 对外地址：微信回调、订阅状态页链接都用它拼
BASE_URL=https://bazi.keyfocus.cn
# CORS 白名单（前端与 API 同源，这里只是兜底）
ALLOWED_ORIGINS=https://bazi.keyfocus.cn

# 管理后台口令（/#/admin）。不配则技能写操作一律拒绝。
ADMIN_PASSWORD=
# 元气 AI：DeepSeek 官方密钥（必填），MiniMax 备选（可选）
DEEPSEEK_API_KEY=
# MINIMAX_API_KEY=
# AGENT_DEFAULT_ROUTE=deepseek-flash

# 短信/微信凭证见 server/README.md「上线配置」，不配则走本地降级（验证码打日志）。

# /etc/bazi/env —— bazi.service 的 EnvironmentFile。首次部署前在服务器上手工创建：
#   install -d -m 0750 /etc/bazi && install -m 0640 -o root -g bazi /dev/null /etc/bazi/env
# PORT / HOST / NODE_ENV / HOME 由 unit 提供，不要写在这里。

# 对外地址：微信回调、订阅状态页链接都用它拼
BASE_URL=https://bazi.keyfocus.cn
# CORS 白名单（前端与 API 同源，这里只是兜底）
ALLOWED_ORIGINS=https://bazi.keyfocus.cn

# 管理后台口令（/#/admin）。不配则管理接口一律 403。
# ⚠ 必须设一个强口令：这是单一静态口令，虽已加失败限流，仍不要用弱口令或示例值。
ADMIN_PASSWORD=
# JWT 签名密钥（强烈建议显式配置）。留空时服务端会在 data/ 下自动生成并持久化，
# 单机能用；但显式配置才便于轮换，也才能在将来加第二个实例时保持登录态互通。
# 生成：openssl rand -base64 48
JWT_SECRET=

# 注册防刷：生产环境默认强制 Cloudflare Turnstile。这里填写 Secret key；
# 前端构建环境另配 VITE_TURNSTILE_SITE_KEY（见根目录 .env.example）。
# 不配置时生产账号注册会返回“注册验证暂不可用”，不会降级成开放注册。
TURNSTILE_SECRET_KEY=
# CAPTCHA_REQUIRED=1

# 订阅/模型的默认限流已在代码中生效。根据实际流量按需微调：
# SMS_IP_PER_HOUR=12
# SMS_VERIFY_IP_PER_HOUR=30
# SUBSCRIPTION_IP_PER_HOUR=12
# AGENT_INFLIGHT_PER_USER=1
# AGENT_INFLIGHT_PER_IP=2
# RISK_BLOCK_THRESHOLD=12
# RISK_BLOCK_MINUTES=60

# 元气 AI：DeepSeek 官方密钥（必填），MiniMax 备选（可选）
DEEPSEEK_API_KEY=
# MINIMAX_API_KEY=
# AGENT_DEFAULT_ROUTE=deepseek-flash


# 短信/微信凭证见 server/README.md「上线配置」。
# ⚠ 生产未配置凭证时，模拟短信/微信通道默认关闭（验证码不回显、mock-done 返回 503），
#   订阅功能会显示为不可用 —— 这是刻意的，好过开着一个假流程收集真实手机号。
#   确需在生产联调时才打开：
# ALLOW_MOCK_CHANNELS=1
# 每日推送必须用独立的已审核模板，不能复用验证码模板：
# SMS_PUSH_TEMPLATE_CODE=

# 游客免费额度：未登录用户每天每 IP 可用的 token（默认 5 万 ≈ 7 轮对话）。
# 调大会增加模型账单，调小会更快把人推去注册。
# GUEST_DAILY_TOKENS=50000

# 数据备份：默认每 24 小时快照一次、保留 14 份，存到 data 目录下的 backups/。
# 服务器上记得把 data 目录纳入常规备份（这里的快照只防误删，不防整机故障）。
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

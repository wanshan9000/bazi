# ===================== 元气黄历订阅服务 配置示例 =====================
# 复制为 server/.env 并填入真实凭证。全部留空时进入「本地降级模式」，
# 验证码会打印到后端日志、微信走模拟扫码，方便本地联调。

# 服务端口
PORT=8787

# 生产环境请设为 production（关闭降级提示）
NODE_ENV=development

# 允许跨域的前端地址（逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173

# 后端对外地址（生产必填，用于微信回调拼接）
BASE_URL=http://localhost:8787

# 时区
TZ=Asia/Shanghai

# ---------------- 短信 (二选一：aliyun / tencent / local) ----------------
SMS_PROVIDER=local
# 阿里云
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=元气黄历
SMS_TEMPLATE_CODE=
SMS_REGION=cn-hangzhou
# 腾讯云
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SDK_APP_ID=
# 通用
SMS_TEMPLATE_PARAM={code}
SMS_CODE_TTL_MIN=5
SMS_COOLDOWN_SEC=60

# ---------------- 微信 ----------------
# 微信开放平台「网站应用」的 AppID / AppSecret（用于扫码订阅）
WX_APP_ID=
WX_APP_SECRET=
# 扫码后回跳地址，需与微信后台配置的一致，例如 https://your-domain.com/api/wechat/callback
WX_REDIRECT_URI=

# ---------------- 定时推送时段 ----------------
PUSH_MORNING_HHMM=07:00
PUSH_NOON_HHMM=12:00
PUSH_EVENING_HHMM=21:00

# ---------------- 管理后台 ----------------
# 管理后台密码（用于导入/管理自定义技能）。配置后才允许写操作；
# 未配置时，技能管理页的保存/导入/删除会被拒绝（防未授权注入）。
ADMIN_PASSWORD=change-me
# 管理会话令牌有效期（小时）
ADMIN_TOKEN_TTL_HOURS=24

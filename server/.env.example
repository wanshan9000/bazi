# ===================== 元气黄历订阅服务 配置示例 =====================
# 复制为 server/.env 并填入真实凭证。全部留空时进入「本地降级模式」，
# 验证码会打印到后端日志、微信走模拟扫码，方便本地联调。

# 服务端口
PORT=8787

# 生产环境请设为 production（关闭降级提示）
NODE_ENV=development

# 允许跨域的前端地址（逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173

# 后端对外地址（生产必填，用于微信回调拼接）
BASE_URL=http://localhost:8787

# 时区
TZ=Asia/Shanghai

# ---------------- 短信 (二选一：aliyun / tencent / local) ----------------
SMS_PROVIDER=local
# 阿里云
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=元气黄历
SMS_TEMPLATE_CODE=
SMS_REGION=cn-hangzhou
# 腾讯云
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SDK_APP_ID=
# 通用
SMS_TEMPLATE_PARAM={code}
SMS_CODE_TTL_MIN=5
SMS_COOLDOWN_SEC=60

# ---------------- 微信 ----------------
# 微信开放平台「网站应用」的 AppID / AppSecret（用于扫码订阅）
WX_APP_ID=
WX_APP_SECRET=
# 扫码后回跳地址，需与微信后台配置的一致，例如 https://your-domain.com/api/wechat/callback
WX_REDIRECT_URI=

# ---------------- 定时推送时段 ----------------
PUSH_MORNING_HHMM=07:00
PUSH_NOON_HHMM=12:00
PUSH_EVENING_HHMM=21:00

# ---------------- 管理后台 ----------------
# 管理后台密码（用于导入/管理自定义技能）。配置后才允许写操作；
# 未配置时，技能管理页的保存/导入/删除会被拒绝（防未授权注入）。
ADMIN_PASSWORD=change-me
# 管理会话令牌有效期（小时）
ADMIN_TOKEN_TTL_HOURS=24

# ---- 元气 AI（dsh 基座）----
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
AGENT_DEFAULT_ROUTE=deepseek-flash

# ============ 以下为 config.js 实际会读、但此前模板里漏掉的变量 ============

# 监听地址。本地默认 0.0.0.0 便于手机联调；生产由 systemd unit 钉成 127.0.0.1。
# HOST=0.0.0.0

# Express trust proxy。生产经 Caddy 反代时必须能识别真实来源 IP，
# 否则所有按 IP 的限流会退化成「全站共用一个桶」。默认 loopback 即可。
# TRUST_PROXY=loopback

# 是否允许「模拟短信/微信」降级能力对外可用。
# 生产（NODE_ENV=production）默认关闭：未配置真实凭证时，验证码不再随响应回显、
# /api/wechat/mock-done 直接 503。确需在生产联调才设为 1。
# ALLOW_MOCK_CHANNELS=1

# 每日推送短信模板（必须与验证码模板不同！验证码模板只有 {code} 变量，
# 拿它发黄历正文会被服务商以「模板变量不匹配」拒绝）。
SMS_PUSH_TEMPLATE_CODE=

# 微信公众号模板消息 ID（每日推送用）
WX_TEMPLATE_ID=
# 微信 access_token 本地缓存文件
# WX_TOKEN_CACHE=

# 数据文件位置（默认在 server/data/ 下；生产需挂持久卷）
# STORE_FILE=./server/data/subscribers.json
# AGENT_STORE_FILE=./server/data/agent_sessions.json

# 报告分享短链有效期（天），默认 30
# SHARE_TTL_DAYS=30
